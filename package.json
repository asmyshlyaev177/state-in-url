      ]
    },
    "kill-astro": {
      "command": "node scripts/kill-demos.mjs astro"
    },
    "dev:astro": {
      "command": "cd packages/example-astro && ../../scripts/portless.sh -- pnpm run dev",
      "service": true,
      "comment": "ASTRO_DEV_BACKGROUND=1 is Astro 7's opt-out of its agent detection, which otherwise backgrounds `astro dev` under Claude Code/Cursor and ends this service; --ignore-lock keeps a stale .astro/dev.json from a killed run from blocking it."
    },
    "build:astro": {
      "command": "cd packages/example-astro && pnpm run build",
      "dependencies": [
        "build"
      ]
