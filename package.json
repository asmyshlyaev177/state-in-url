{
  "name": "state-in-url",
  "version": "6.4.1",
  "description": "Store state in URL as in object, types and structure are preserved, with TS validation. Same API as React.useState, wthout any hasssle or boilerplate. Next.js@14-16, react-router@6-7, remix@2, and Astro.",
  "homepage": "https://state-in-url.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmyshlyaev177/state-in-url.git"
  },
  "author": {
    "name": "Aleksandr Smyshliaev",
    "email": "asmyshlyaev177@gmail.com",
    "url": "https://asmyshlyaev177.dev"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  },
  "license": "MIT",
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/asmyshlyaev177"
  },
  "bugs": {
    "url": "https://github.com/asmyshlyaev177/state-in-url/issues"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "main": "./dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./next": {
      "require": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.mjs"
    },
    "./react-router6": {
      "require": "./dist/react-router6/index.js",
      "types": "./dist/react-router6/index.d.ts",
      "default": "./dist/react-router6/index.mjs"
    },
    "./react-router": {
      "require": "./dist/react-router/index.js",
      "types": "./dist/react-router/index.d.ts",
      "default": "./dist/react-router/index.mjs"
    },
    "./remix": {
      "require": "./dist/remix/index.js",
      "types": "./dist/remix/index.d.ts",
      "default": "./dist/remix/index.mjs"
    },
    "./astro": {
      "require": "./dist/astro/index.js",
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.mjs"
    },
    "./encodeState": {
      "require": "./dist/encodeState/index.js",
      "types": "./dist/encodeState/index.d.ts",
      "default": "./dist/encodeState/index.mjs"
    },
    "./encoder": {
      "require": "./dist/encoder/index.js",
      "types": "./dist/encoder/index.d.ts",
      "default": "./dist/encoder/index.mjs"
    },
    "./useSharedState": {
      "require": "./dist/useSharedState/index.js",
      "types": "./dist/useSharedState/index.d.ts",
      "default": "./dist/useSharedState/index.mjs"
    },
    "./useLinkProps": {
      "require": "./dist/useLinkProps/index.js",
      "types": "./dist/useLinkProps/index.d.ts",
      "default": "./dist/useLinkProps/index.mjs"
    },
    "./useUrlEncode": {
      "require": "./dist/useUrlEncode/index.js",
      "types": "./dist/useUrlEncode/index.d.ts",
      "default": "./dist/useUrlEncode/index.mjs"
    },
    "./useUrlStateBase": {
      "require": "./dist/useUrlStateBase/index.js",
      "types": "./dist/useUrlStateBase/index.d.ts",
      "default": "./dist/useUrlStateBase/index.mjs"
    },
    "./utils": {
      "require": "./dist/utils.js",
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "i18n": "node scripts/i18n/cli.mjs",
    "i18n:init": "node scripts/i18n/cli.mjs init",
    "i18n:toc": "node scripts/i18n/cli.mjs toc",
    "i18n:check": "node scripts/i18n/cli.mjs check",
    "i18n:copy": "node scripts/i18n/copy.mjs",
    "i18n:copy:init": "node scripts/i18n/copy.mjs init",
    "i18n:copy:check": "node scripts/i18n/copy.mjs check",
    "test:unit": "wireit",
    "test:int": "wireit",
    "test:int:ci": "wireit",
    "test:exports": "pnpm run build && npx babel-node --extensions .js,.mjs,.ts,.mts --config-file ./babel.config.json -- ./packages/urlstate/exportsTest.ts",
    "test": "wireit",
    "dev": "wireit",
    "dev:lib": "wireit",
    "dev:nextjs14": "wireit",
    "dev:nextjs15": "wireit",
    "dev:nextjs16": "wireit",
    "dev:remix2": "wireit",
    "tsc": "wireit",
    "build": "wireit",
    "build:demo": "wireit",
    "start:demo": "wireit",
    "lighthouse:serve": "cd packages/example-nextjs16 && pnpm exec next start --port 3012",
    "test:lighthouse": "playwright test -c playwright.lighthouse.config.ts",
    "build:packages": "wireit",
    "start:demo15": "wireit",
    "start:demo15:ci": "wireit",
    "start:react": "wireit",
    "start": "wireit",
    "start:ci": "wireit",
    "kill-next": "wireit",
    "kill-vite": "wireit",
    "kill-remix": "wireit",
    "kill-services": "wireit",
    "kill": "wireit",
    "bump": "npx standard-version --no-verify",
    "install:all": "pnpm install",
    "install:ci": "pnpm install --frozen-lockfile",
    "rmdist": "rm -rf dist",
    "cleanup": "rm -rf dist .wireit node_modules test-results playwright-report coverage-reports nyc_coverage packages/example-nextjs14/node_modules packages/example-nextjs14/.next packages/example-nextjs15/node_modules packages/example-nextjs15/.next packages/example-nextjs16/node_modules packages/example-nextjs16/.next packages/example-react/node_modules packages/example-react-router6/node_modules packages/example-react-router7/node_modules packages/example-remix2/node_modules packages/example-astro/node_modules packages/example-astro/dist packages/example-astro/.astro",
    "reinstall": "pnpm run cleanup && pnpm install",
    "setup": "playwright install --with-deps",
    "prepack": "pnpm run build && cp package.json dist/package.json",
    "pin-gh-deps": "pin-github-action -i .github/workflows/tests.yml .github/workflows/lighthouse.yml",
    "prepare": "pnpm exec husky",
    "dev:astro": "wireit",
    "kill-astro": "wireit"
  },
  "wireit": {
    "dev": {
      "dependencies": [
        "dev:lib",
        "dev:react",
        "dev:remix2",
        "dev:router6",
        "dev:router7",
        "dev:nextjs16",
        "start:demo14",
        "dev:astro"
      ],
      "service": {
        "readyWhen": {
          "lineMatches": "Ready in"
        }
      },
      "command": "pnpm run dev:nextjs15"
    },
    "test": {
      "dependencies": [
        "tsc",
        "test:unit",
        "build:packages"
      ],
      "command": "pnpm run test:exports && pnpm run test:int"
    },
    "kill-next": {
      "command": "node scripts/kill-demos.mjs next"
    },
    "kill-vite": {
      "command": "node scripts/kill-demos.mjs vite"
    },
    "kill-remix": {
      "command": "node scripts/kill-demos.mjs remix"
    },
    "kill-services": {
      "command": "node scripts/kill-demos.mjs next vite remix astro",
      "comment": "Matching is by repo cwd plus the server's own argv, and never touches an ancestor of the killer. See scripts/kill-demos.mjs for the two ways the old ps|grep|xargs form mis-fired."
    },
    "kill-wireit": {
      "command": "node scripts/kill-demos.mjs wireit"
    },
    "kill": {
      "command": "node scripts/kill-demos.mjs"
    },
    "test:int:ci": {
      "command": "pnpm exec cross-env HOME=/root PLAYWRIGHT_BROWSERS_PATH=0 playwright test"
    },
    "test:int": {
      "comment": "Kills leftover demo servers first: a finished run leaves a partial set behind, and Playwright's reuseExistingServer adopts it as soon as example-nextjs16 answers without ever starting the missing apps (tests/wait-for-servers.ts names the failure). To test against servers you started yourself, run `pnpm exec playwright test` directly.",
      "dependencies": [
        "kill-services"
      ],
      "command": "playwright test --project=chromium --retries=2"
    },
    "tsc": {
      "comment": "The examples import `state-in-url`, so they need a built `dist/`. Without this, `pnpm run test` runs tsc alongside `build`, whose `rmdist` wipes it: TS2307 everywhere.",
      "dependencies": [
        "build"
      ],
      "command": "pnpm exec tsc --noEmit"
    },
    "test:unit": {
      "comment": "`--run`, not watch: `pnpm run test` depends on this and a watching vitest never exits. `npx vitest` for watch.",
      "dependencies": [
        "tsc"
      ],
      "command": "pnpm exec vitest --run"
    },
    "dev:lib": {
      "command": "cross-env IS_DEVELOPMENT=true rollup -c rollup.config.mjs -w",
      "service": {
        "readyWhen": {
          "lineMatches": "created "
        }
      },
      "dependencies": [
        "rmdist"
      ]
    },
    "dev:router6": {
      "command": "cd packages/example-react-router6 && ../../scripts/portless.sh -- pnpm run dev",
      "service": true
    },
    "dev:router7": {
      "command": "cd packages/example-react-router7 && ../../scripts/portless.sh -- pnpm run dev",
      "service": true
    },
    "dev:remix2": {
      "command": "cd packages/example-remix2 && ../../scripts/portless.sh -- pnpm run dev",
      "service": true
    },
    "dev:nextjs14": {
      "command": "cd packages/example-nextjs14 && ../../scripts/portless.sh -- pnpm run dev --turbo",
      "service": true
    },
    "dev:nextjs15": {
      "command": "cd packages/example-nextjs15 && ../../scripts/portless.sh -- pnpm run dev",
      "service": true,
      "comment": "No --turbo: Turbopack 15.5.19 panics with \"Next.js package not found\" against this pnpm layout (it reports version 0.0.0), and one failed service tears down the rest. 14 and 16 are unaffected."
    },
    "dev:nextjs16": {
      "command": "cd packages/example-nextjs16 && ../../scripts/portless.sh -- pnpm run dev --turbo",
      "service": true
    },
    "build:next14": {
      "command": "cd packages/example-nextjs14 && pnpm run build",
      "dependencies": [
        "build"
      ]
    },
    "build:next15": {
      "command": "cd packages/example-nextjs15 && pnpm run build",
      "dependencies": [
        "build"
      ]
    },
    "build:next16": {
      "command": "cd packages/example-nextjs16 && pnpm run build",
      "dependencies": [
        "build"
      ]
    },
    "build:router6": {
