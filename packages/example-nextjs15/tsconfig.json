{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "noEmit": true,
    "incremental": true,
    // Next 14/15 resolve "paths" from this dir when baseUrl is unset (16 uses the base file's dir)
    "paths": {
      "shared/components": ["../shared/components/index.ts"],
      "shared/components/*": ["../shared/components/*"],
      "shared/*": ["../shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../shared",
    "./global.d.ts"
  ],
  "exclude": ["node_modules"]
}
