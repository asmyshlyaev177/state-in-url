---
import Layout from '../layouts/Layout.astro';
import { Form } from '../components/Form-for-test';
import { Status } from '../components/Status-for-test';

// Two islands, two React roots: the state is shared through the module, not a provider.
const searchParams = Object.fromEntries(Astro.url.searchParams);
---

<Layout>
  <div class="bg-white rounded-lg shadow-2xl p-8 max-w-4xl w-full h-[1250px]">
    <header class="mb-8 flex justify-between items-center">
      <h1 class="text-3xl font-bold text-gray-800">
        <span class="font-mono">state-in-url</span> Demo
      </h1>
    </header>

    <div class="flex flex-col md:flex-row gap-8 text-black">
      <Form
        client:load
        searchParams={searchParams}
        className="flex max-h-[650px] flex-col md:flex-row gap-8 basis-1/2"
      />
      <Status
        client:load
        searchParams={searchParams}
        className="flex-1 max-h-[650px] bg-gray-100 rounded-lg p-4 flex flex-col shadow-md border border-grey basis-1/2 grow-0"
      />
    </div>
    <a href="/few-components/1" class="text-black">Few components</a>
    <a href="/useHook-race-condition" class="text-black ml-4">Race Condition Test</a>
    <a href="/pure-astro" class="text-black ml-4">Pure Astro, no islands</a>
  </div>
</Layout>
